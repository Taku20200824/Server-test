rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/irisUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/irisUsers/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function validLoginId(value) {
      return value is string && value.matches('^[0-9]{1,20}$');
    }

    function validCreatedRole(loginId, role) {
      return (loginId.matches('^9.*') && role == 'admin')
        || (!loginId.matches('^9.*') && role == 'customer');
    }

    function isLegacyCollection(collectionName) {
      return collectionName in [
        'announcements',
        'events',
        'features',
        'gallery',
        'irisAccounts',
        'mapMarkers',
        'rules',
        'scores',
        'serverStatus',
        'siteText',
        'staff'
      ];
    }

    // ---------------------------------------------------------
    // アカウント（ID・表示名・権限）
    //   ID が 9 で始まる場合は admin、それ以外は customer。
    //   作成後にアプリ側から role を変更することはできない。
    // ---------------------------------------------------------
    match /irisUsers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'role', 'updatedAt'])
        && validLoginId(request.resource.data.username)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && validCreatedRole(request.resource.data.username, request.resource.data.role);

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'role', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.username == resource.data.username
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // ---------------------------------------------------------
    // バーコードレコード（共有台帳）
    //   閲覧はログイン済みユーザー全員。
    //   変更・削除は登録者本人か管理者だけ。
    // ---------------------------------------------------------
    match /irisRecords/{recordId} {
      function validRecord() {
        return request.resource.data.keys().hasOnly(
            ['no', 'barcode', 'name', 'kanji', 'katakana', 'address', 'ownerUid', 'ownerName', 'addedDateTime', 'updatedAt'])
          && request.resource.data.no is int
          && request.resource.data.no > 0
          && request.resource.data.barcode is string
          && request.resource.data.barcode.matches('^[0-9]{1,20}$')
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 160
          && request.resource.data.kanji is string
          && request.resource.data.kanji.size() <= 160
          && request.resource.data.katakana is string
          && request.resource.data.katakana.size() <= 160
          && request.resource.data.address is string
          && request.resource.data.address.size() <= 300
          && request.resource.data.ownerName is string
          && request.resource.data.ownerName.size() <= 80
          && request.resource.data.addedDateTime is string
          && request.resource.data.addedDateTime.size() <= 40;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && validRecord()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if (isOwner() || isAdmin())
        && validRecord()
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isOwner() || isAdmin();
    }

    // ---------------------------------------------------------
    // 付箋メモ（本人だけが読み書きできる）
    // ---------------------------------------------------------
    match /irisNotes/{noteId} {
      function validNote() {
        return request.resource.data.keys().hasOnly(['body', 'color', 'x', 'y', 'ownerUid', 'updatedAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 3000
          && request.resource.data.color in ['lemon', 'mint', 'rose', 'iris']
          && request.resource.data.x is number
          && request.resource.data.y is number;
      }

      allow read: if isOwner();

      allow create: if signedIn()
        && validNote()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isOwner()
        && validNote()
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isOwner();
    }

    // ---------------------------------------------------------
    // 旧 THE-ISLE / 不要データの cleanup 用。
    // admin だけが一覧取得と削除できる。新規作成・更新は不可。
    // ---------------------------------------------------------
    match /{legacyCollection}/{documentId} {
      allow read, delete: if isAdmin() && isLegacyCollection(legacyCollection);
      allow create, update: if false;
    }
  }
}
