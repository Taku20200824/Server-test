rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    match /serverStatus/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /employees/{documentId} {
      allow read: if true;
      allow create: if request.resource.data.employeeId is string
        && request.resource.data.name is string
        && request.resource.data.employeeId.size() > 0
        && request.resource.data.name.size() > 0;
      allow update, delete: if isAdmin();
    }

    match /siteText/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsCards/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /features/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rules/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dinosaurs/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mapMarkers/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /donationRewards/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /donationGoals/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /scores/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /playerProfiles/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /playerSessions/{documentId} {
      allow read, write: if isAdmin();
    }

    match /staff/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reports/{documentId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
